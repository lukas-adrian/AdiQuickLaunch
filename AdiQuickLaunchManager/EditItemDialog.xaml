<Window x:Class="AdiQuickLaunchManager.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AdiQuickLaunchManager"
        mc:Ignorable="d"
        Title="Edit Item"
        Width="500" Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Name" Foreground="White" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" Background="#2D2D30" Foreground="White"
                     BorderBrush="#3F3F46" Padding="6,4" />
        </StackPanel>

        <!-- Path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Path" Foreground="White" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Background="#2D2D30" Foreground="White"
                         BorderBrush="#3F3F46" Padding="6,4" />
                <Button Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0"
                        Background="#3F3F46" Foreground="White" BorderThickness="0"
                        Click="BrowseButton_Click" />
            </Grid>
        </StackPanel>

        <!-- Parameters -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Parameters" Foreground="White" Margin="0,0,0,4" />
            <TextBox x:Name="ParametersBox" Background="#2D2D30" Foreground="White"
                     BorderBrush="#3F3F46" Padding="6,4" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="0,0,10,0"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    Padding="10,6" Click="OK_Click" />
            <Button Content="Cancel" Width="75"
                    Background="#3F3F46" Foreground="White" BorderThickness="0"
                    Padding="10,6" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>